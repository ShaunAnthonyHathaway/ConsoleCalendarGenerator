# Formatting rules that editors and "dotnet format" apply to this repository.
root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion

[*.{csproj,props,targets,config,json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
end_of_line = lf

# The legacy class has no XML documentation yet, so the missing-comment warning is off for this file only.
# Every other public type in the library must be documented. See docs/ai-context/decisions.md (D-11).
[ConsoleCalendarGenerator/ConsoleCalendar.cs]
dotnet_diagnostic.CS1591.severity = none
