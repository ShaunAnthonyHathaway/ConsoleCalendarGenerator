<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Program.cs supplies the entry point: the tests start this assembly as a child process. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!--
    The library is built for net10.0 and netstandard2.1, and a net11.0 project would normally only ever see the
    net10.0 build. LibraryTargetFramework chooses which build the tests run against:

      dotnet test                                              (net10.0, the default)
      dotnet test -p:LibraryTargetFramework=netstandard2.1

    The second form builds into its own folders, so the two never overwrite each other.
  -->
  <PropertyGroup>
    <LibraryTargetFramework Condition="'$(LibraryTargetFramework)' == ''">net10.0</LibraryTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LibraryTargetFramework)' != 'net10.0'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)-with-$(LibraryTargetFramework)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)-with-$(LibraryTargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!--
    The parity fixtures are embedded in the test assembly, so the tests read them without depending on where the
    assembly is, and without Campertron or the network. They are test data and are never packed.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Parity\Campertron\Fixtures\*.json" LogicalName="ParityFixtures.Campertron.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsoleCalendarGenerator\ConsoleCalendarGenerator.csproj"
                      SetTargetFramework="TargetFramework=$(LibraryTargetFramework)"
                      GlobalPropertiesToRemove="LibraryTargetFramework" />
    <!-- Read by LibraryBuildTests, which fails if the tests are not running against the build asked for. -->
    <AssemblyMetadata Include="LibraryTargetFramework" Value="$(LibraryTargetFramework)" />
  </ItemGroup>

  <!--
    The example application, for the tests in Documentation. Its Examples.cs holds the code README.md shows, and
    is compiled into the tests as well, so that every example is also compiled against whichever build of the
    library the tests run against. The project reference only makes sure the program is built before the tests
    start it; nothing of it is referenced or copied.
  -->
  <ItemGroup>
    <Compile Include="..\ConsoleCalendarGeneratorExample\Examples.cs" Link="Documentation\Examples.cs" />
    <ProjectReference Include="..\ConsoleCalendarGeneratorExample\ConsoleCalendarGeneratorExample.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      GlobalPropertiesToRemove="LibraryTargetFramework" />
  </ItemGroup>

</Project>
