<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 is what 1.0.0 shipped and stays for existing consumers. net10.0 is the current asset. -->
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>

    <!--
      Turns on the trim, single-file and Native AOT analyzers for the net10.0 build and marks that assembly as
      trimmable. eng/consumer-smoke.sh publishes a Native AOT application against the package to back the claim.
    -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>

    <!--
      The XML documentation file ships in the package. A public member without an XML comment is a build
      warning (CS1591), which is not turned off anywhere: every public type and member is documented, the
      legacy class included.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>ConsoleCalendarGenerator</PackageId>

    <!--
      Development version of 2.0, the next version to be published. 1.0.0 is the only published version; nothing
      built from this repository may carry that number. The release will be 2.0.0: the suffix is removed only
      in the change that prepares an approved release, and no prerelease is published.
    -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <!--
      The assembly version is the major version of the package and nothing more: 2.0.0.0 for every 2.x version,
      as it was 1.0.0.0 in 1.0.0. The file version follows the version prefix. The informational version is the
      package version with the commit, which the SDK adds.
    -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>

    <Authors>Shaun Hathaway</Authors>
    <Copyright>Copyright (c) 2023 Shaun Hathaway</Copyright>
    <!--
      The description and the tags are what nuget.org shows and searches. They describe the modern API first,
      because that is what the package is for from 2.0 on, and say that the 1.0 class is still there.
    -->
    <Description>Lays out and renders month calendars for .NET console applications: as plain text, as structured segments you can style yourself, or straight to the console in color. Marked dates show in the text itself, in any culture and with any first day of the week. Includes the ConsoleCalendar class of version 1.0 for existing code.</Description>
    <PackageTags>console;calendar;month;terminal;cli;date;text;layout</PackageTags>
    <!--
      Where the changes of a version are listed. While the package is a development version this is the
      changelog on the default branch. Whether a released package points at the tag of its release instead is
      settled when the release is prepared; see docs/ai-context/packaging-and-releases.md.
    -->
    <PackageReleaseNotes>https://github.com/ShaunAnthonyHathaway/ConsoleCalendarGenerator/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ShaunAnthonyHathaway/ConsoleCalendarGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShaunAnthonyHathaway/ConsoleCalendarGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols go in a separate .snupkg. Source Link comes with the SDK and points the symbols at this repository. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Package validation runs at the end of every "dotnet pack" of this project and fails it when the public API is
    no longer compatible with the published 1.0.0 package, or when the two builds in the package differ.
    Restoring this project downloads ConsoleCalendarGenerator 1.0.0 from nuget.org once, into the NuGet package
    cache, to compare against. To pack without it: dotnet pack -p:EnablePackageValidation=false
  -->
  <PropertyGroup Label="Package validation">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <!-- Renaming a parameter breaks callers that use named arguments, so that counts as a break too. -->
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
