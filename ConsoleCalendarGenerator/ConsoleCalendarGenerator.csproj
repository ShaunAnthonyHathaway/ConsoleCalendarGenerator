<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 is the build 1.0.0 had and stays for existing consumers. net10.0 is the current asset. -->
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>

    <!--
      Turns on the trim, single-file and Native AOT analyzers for the net10.0 build and marks that assembly as
      trimmable. eng/consumer-smoke.sh publishes a Native AOT application against the package to back the claim.
    -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>

    <!--
      The XML documentation file ships in the package. A public member without an XML comment is a build
      warning (CS1591), which is not turned off anywhere: every public type and member is documented.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>ConsoleCalendarGenerator</PackageId>

    <!--
      Version 2.0.1, with no suffix: this is the source of the release. Every build of it identifies itself as
      2.0.1, wherever it is made, but only one build is the release: the candidate, which is designated once
      and never built again (docs/ai-context/packaging-and-releases.md). A released version is never changed:
      2.0.0 is released on GitHub and 1.0.0 is published on NuGet, and nothing built from this repository may
      carry either number.
    -->
    <VersionPrefix>2.0.1</VersionPrefix>
    <!--
      The assembly version is the major version of the package and nothing more: 2.0.0.0 for every 2.x version,
      as it was 1.0.0.0 in 1.0.0. The file version follows the version prefix: 2.0.1.0. The informational
      version is the package version with the commit, which the SDK adds.
    -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>

    <Authors>Shaun Hathaway</Authors>
    <Copyright>Copyright (c) 2023 Shaun Hathaway</Copyright>
    <!--
      The description and the tags are what nuget.org shows and searches: what the package lets an application
      do, and that the original ConsoleCalendar API is part of it.
    -->
    <Description>Create month calendars for .NET applications with deterministic text rendering, structured semantic output, configurable culture and layout, visible date markers, themes, and console support. The original ConsoleCalendar API remains available for existing applications.</Description>
    <PackageTags>calendar;console;terminal;cli;month;date;layout;rendering</PackageTags>
    <!--
      Where the changes of a version are listed: the changelog on the default branch, for the release as well.
      The changelog is a document of current policy, like the other documents the readme links on that branch;
      it gets the date of a release when the release is published, which a copy at the tag could never show.
    -->
    <PackageReleaseNotes>https://github.com/ShaunAnthonyHathaway/ConsoleCalendarGenerator/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ShaunAnthonyHathaway/ConsoleCalendarGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShaunAnthonyHathaway/ConsoleCalendarGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols go in a separate .snupkg. Source Link comes with the SDK and points the symbols at this repository. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Package validation runs at the end of every "dotnet pack" of this project and fails it when the public API is
    no longer compatible with the published 1.0.0 package, or when the two builds in the package differ.
    Restoring this project downloads ConsoleCalendarGenerator 1.0.0 from nuget.org once, into the NuGet package
    cache, to compare against. To pack without it: dotnet pack -p:EnablePackageValidation=false
  -->
  <PropertyGroup Label="Package validation">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <!-- Renaming a parameter breaks callers that use named arguments, so that counts as a break too. -->
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
