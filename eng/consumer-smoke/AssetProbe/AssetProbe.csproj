<Project Sdk="Microsoft.NET.Sdk">

  <!-- A minimal application that installs the package under test. eng/consumer-smoke.sh builds and runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ConsumerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <!--
      Run on whatever newer runtime the machine has. This does not change which build of the library is used:
      that is decided by the target framework when the package is restored.
    -->
    <RollForward>LatestMajor</RollForward>
    <!-- An older framework is targeted on purpose, to select the package's netstandard2.1 build. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleCalendarGenerator" Version="[$(PackageUnderTestVersion)]" />
  </ItemGroup>

  <!-- For the Native AOT publish: analyze the whole library, not only the members this program calls. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="ConsoleCalendarGenerator" />
  </ItemGroup>

</Project>
