<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Program.cs is the sample program that accompanied ConsoleCalendarGenerator 1.0.0, byte for byte. It must
    keep compiling against every later 1.x package without being edited. eng/consumer-smoke.sh builds it; it is
    not run, because it waits for key presses.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleCalendarGenerator" Version="[$(PackageUnderTestVersion)]" />
  </ItemGroup>

</Project>
