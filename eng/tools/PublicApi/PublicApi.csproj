<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A small tool for the publication scripts: it writes out the public API of an assembly and compares it with
    eng/public-api.txt. It is not part of the solution, not packed and not shipped. The scripts build it in a
    temporary folder. PublicApiListing.cs is also compiled into the tests, which hold the library to the same file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <!-- Run on whatever newer runtime the machine has, like the applications of the smoke tests. -->
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
